WINAUTH_USERNAME=admin
# Set a long, unique password. There is intentionally no default.
WINAUTH_PASSWORD=
# Alternatively set WINAUTH_PASSWORD_HASH to a Werkzeug generate_password_hash value.
WINAUTH_DATA_DIR=./data
WINAUTH_HOST=127.0.0.1
WINAUTH_PORT=8080
# Enable behind an HTTPS reverse proxy (also enables HSTS).
WINAUTH_HTTPS_ONLY=false

